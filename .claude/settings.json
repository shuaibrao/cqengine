{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *-f)",
      "Bash(rm -rf src*)",
      "Bash(rm -rf ./src*)",
      "Bash(rm -rf gradle*)",
      "Bash(rm -rf ./gradle*)",
      "Bash(rm -rf scripts*)",
      "Bash(rm -rf ./scripts*)",
      "Bash(rm -rf documentation*)",
      "Bash(rm -rf ./documentation*)",
      "Bash(rm -rf benchmarks*)",
      "Bash(rm -rf ./benchmarks*)",
      "Bash(rm -rf consumer-tests*)",
      "Bash(rm -rf ./consumer-tests*)",
      "Bash(rm -rf config*)",
      "Bash(rm -rf ./config*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agent/hooks/session_init.py --harness claudecode"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agent/hooks/shell_exec_guard.py --harness claudecode"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agent/hooks/self_improvement_check.py --harness claudecode"
          }
        ]
      }
    ]
  }
}
